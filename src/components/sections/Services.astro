---
import SectionHeading from '../SectionHeading.astro';

/** Accent rotates yellow → green → blue → pink across the four cards. */
const accents = {
  yellow: 'bg-neo-yellow',
  green: 'bg-neo-green',
  blue: 'bg-neo-blue',
  pink: 'bg-neo-pink',
} as const;

const services = [
  {
    index: '01',
    accent: 'yellow',
    title: 'Social Media Management',
    body: 'We run the account end to end — daily publishing, community management, and a calendar that comes out of a strategy rather than a spreadsheet.',
    deliverables: [
      'Content calendar',
      'Copywriting',
      'Community replies',
      'Monthly reporting',
    ],
    // Lucide: message-circle-more
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  },
  {
    index: '02',
    accent: 'green',
    title: 'Viral Reels & Brand Shoots',
    body: 'Shot on Sony A7S III. Hooks written for retention, edits cut for the algorithm, and product stills that do not look like everyone else’s.',
    deliverables: [
      'Reel packs',
      'Product & brand stills',
      'On-location shoots',
      'Post-production',
    ],
    // Lucide: video
    icon: '<path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2"/>',
  },
  {
    index: '03',
    accent: 'blue',
    title: 'Paid Ads (Meta / Google)',
    body: 'Creative-led performance campaigns. We build the creative, run the tests, and scale what converts — not what looks good in a deck.',
    deliverables: [
      'Campaign setup',
      'Creative testing',
      'Pixel & tracking',
      'Weekly optimisation',
    ],
    // Lucide: target
    icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  },
  {
    index: '04',
    accent: 'pink',
    title: 'Content Strategy',
    body: 'Positioning, pillars, and a 90-day roadmap. We audit what you have, find the gap, and hand over a system your team can actually run.',
    deliverables: [
      'Account audit',
      'Content pillars',
      'Hook library',
      '90-day roadmap',
    ],
    // Lucide: compass
    icon: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  },
] as const;
---

<section id="services" class="scroll-mt-24 py-16 sm:py-24 lg:py-32">
  <div class="neo-container">
    <div data-reveal>
      <SectionHeading eyebrow="What we do" index="02" accent="yellow">
        Four Ways We<br class="hidden sm:inline" />Grow Your Brand
      </SectionHeading>
      <p class="mt-5 max-w-2xl text-base leading-relaxed sm:mt-6 sm:text-lg text-neo-black/70">
        Take one, or take the whole stack. Most brands start with content and add
        paid once the creative is proven.
      </p>
    </div>

    {/* Two-up starts at md (768px), not sm (640px). These cards carry a heading,
        a paragraph and a four-item list; at 640px a two-column split left each
        one ~226px of inner width, which broke "Social Media Management" across
        three lines and wrapped the longer deliverables. One column until there
        is genuinely room for two. */}
    <div data-reveal-grid class="mt-10 grid gap-6 sm:mt-14 md:grid-cols-2 lg:gap-8">
      {
        services.map((service) => (
          <article class="neo-press group flex min-w-0 flex-col rounded-neo border-3 border-neo-black bg-neo-offwhite p-6 shadow-neo sm:p-7 lg:p-9">
            <div class="flex items-start justify-between gap-4">
              <span
                class={`inline-grid size-12 shrink-0 place-items-center rounded-neo-sm border-3 border-neo-black text-neo-black shadow-neo-sm transition-transform duration-150 group-hover:scale-105 sm:size-14 ${accents[service.accent]}`}
                aria-hidden="true"
              >
                <svg
                  class="size-6 sm:size-7"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={service.icon}
                />
              </span>
              <span
                class="font-mono text-sm font-bold tracking-widest text-neo-black/30"
                aria-hidden="true"
              >
                {service.index}
              </span>
            </div>

            <h3 class="mt-5 font-display text-base font-extrabold uppercase sm:mt-6 sm:text-xl md:text-2xl lg:text-3xl">
              {service.title}
            </h3>

            <p class="mt-3 text-sm leading-relaxed text-neo-black/70 sm:mt-4 sm:text-base">
              {service.body}
            </p>

            <ul class="mt-6 flex flex-col gap-2 border-t-2 border-neo-black/10 pt-5 sm:mt-7 sm:pt-6">
              {service.deliverables.map((deliverable) => (
                /* items-start, not items-center: these wrap on narrow cards, and
                   centring pushed the tick to the middle of a two-line row. */
                <li class="flex items-start gap-3 font-mono text-[0.6875rem] font-bold tracking-wider uppercase sm:text-xs">
                  <svg
                    class="mt-px size-4 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.5"
                    stroke-linecap="square"
                    aria-hidden="true"
                  >
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  {deliverable}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
