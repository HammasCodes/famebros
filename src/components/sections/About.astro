---
import SectionHeading from '../SectionHeading.astro';
import NeoTag from '../NeoTag.astro';

const credentials = ['Mumbai Based', '50+ Accounts Managed', 'Sony A7S III'];
---

<section id="about" class="scroll-mt-24 py-24 lg:py-32">
  <div class="neo-container">
    <div data-reveal>
      <SectionHeading eyebrow="About the studio" index="01" accent="green">
        The Bros Behind<br />The Camera
      </SectionHeading>

      <ul class="mt-8 flex flex-wrap gap-3">
        {
          credentials.map((credential) => (
            <li>
              <NeoTag color="green" class="shadow-neo-sm">
                {credential}
              </NeoTag>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div data-reveal class="flex flex-col gap-6 lg:col-span-7">
        <p class="text-lg leading-relaxed text-neo-black/80">
          Fame Bros Studio is a small creative unit built around one idea:
          attention is earned, not bought. We run the full pipeline in-house —
          strategy, shoot, edit, publish, and paid distribution — so your brand
          shows up every day with work that's actually worth stopping for.
        </p>
        <p class="text-lg leading-relaxed text-neo-black/80">
          Every account starts with a content system rather than a calendar. We
          define the angles, build the shot list, and measure what moves the
          numbers that matter: reach, saves, and qualified enquiries. When
          something works, we put budget behind it. When it doesn't, we cut it
          the same week.
        </p>

        <div
          class="mt-2 flex flex-col gap-4 rounded-neo border-3 border-neo-black bg-neo-offwhite p-6 shadow-neo sm:flex-row sm:items-center sm:gap-6"
        >
          <span
            class="inline-grid size-14 shrink-0 place-items-center rounded-neo-sm border-3 border-neo-black bg-neo-blue shadow-neo-sm"
            aria-hidden="true"
          >
            <svg
              class="size-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"
              ></path>
              <circle cx="12" cy="13" r="3"></circle>
            </svg>
          </span>
          <p class="font-mono text-sm leading-relaxed text-neo-black/80">
            <strong class="font-bold">Shot in-house.</strong> No agency middlemen,
            no stock footage, no borrowed portfolios. The work you see is the work
            we made.
          </p>
        </div>
      </div>

      <div data-reveal class="lg:col-span-5">
        <blockquote
          class="h-full rounded-neo border-4 border-neo-black bg-neo-green p-8 shadow-neo lg:p-10"
        >
          <p
            class="font-display text-3xl leading-tight font-extrabold text-neo-black uppercase sm:text-4xl"
          >
            We don't just post content. We engineer growth.
          </p>
          <footer
            class="mt-8 border-t-2 border-neo-black/30 pt-5 font-mono text-xs tracking-widest text-neo-black/70 uppercase"
          >
            Fame Bros Studio — Operating principle
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>
